# Sistemi Purepower – filter tooling & warehouse register
# Copy to .env and edit. The .env file is read automatically at boot (real
# environment variables always win), so `npm start` needs no extra flags.

# ── runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Absolute base URL used inside QR payloads and label printouts (https in production)
PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info            # error | warn | info | debug
SQL_DEBUG=0               # 1 = log every statement (development only)

# ── session secret ────────────────────────────────────────────────────────
# Required in production. In development a random secret is generated once and
# stored in .data/app-secret (mode 0600) so sessions survive a restart.
#   openssl rand -hex 32
APP_SECRET=

# ── database ──────────────────────────────────────────────────────────────
# DB_MODE=mysql   -> real MySQL / MariaDB server (use this in production)
# DB_MODE=embedded-> in-process MariaDB, zero configuration (development / demo)
# Leaving DB_MODE empty means: mysql when MYSQL_HOST is set, otherwise embedded.
DB_MODE=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=sistemi
MYSQL_PASSWORD=
MYSQL_DATABASE=sistemi_tooling
MYSQL_POOL_SIZE=10
# Where the embedded engine keeps its data files (default: .data/mariadb)
EMBEDDED_DB_DIR=
# NEVER start two processes against the same embedded datadir. If a crash left a
# stale lock or a corrupt undo log, repair once with EMBEDDED_REPAIR=1.
EMBEDDED_REPAIR=0

# ── files ─────────────────────────────────────────────────────────────────
DATA_DIR=.data            # uploads / backups / exports live under this folder
MAX_IMAGE_BYTES=8388608   # 8 MB per photo
MAX_DOC_BYTES=67108864    # 64 MB per CAD / PDF document

# ── security ──────────────────────────────────────────────────────────────
SESSION_TTL_HOURS=16
SECURE_COOKIES=           # 1 = force Secure cookies, 0 = force off; default: on in production
RATE_LIMIT_API_MAX=600    # requests per minute per ip
RATE_LIMIT_WRITE_MAX=120  # mutating requests per minute per ip
RATE_LIMIT_LOGIN_MAX=20   # login attempts per 15 minutes per ip

# ── demo data (development only) ────────────────────────────────────────────
# Overrides the seeded passwords for every demo user – never set in production.
DEMO_PASSWORD=
# Similarity percentage that flags two tools as possible duplicates
DUP_THRESHOLD=85
